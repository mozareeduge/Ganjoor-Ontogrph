# Generated content (build artifacts — never commit)
md/

# Python
__pycache__/
*.pyc

# QMD local index — machine-specific, rebuilt with `qmd update` + `qmd embed`
.qmd/index.sqlite
.qmd/*.sqlite*
.qmd/.cache/

# OS junk
.DS_Store

# Claude Code harness runtime state (ephemeral: session leases, active-session
# registry, instruction cache) — harness-managed, never project artifacts.
# Kept on disk (the harness rewrites them live); kept out of git.
.claude/sessions/
.claude/state/
